              "host": [ "{{base_url}}" ],
              "path": [ "api", "share", "{{uploaded_file_id}}", "metadata" ],
              "query": [
                { "key": "token", "value": "{{share_token}}" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
