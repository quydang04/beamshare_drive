                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.displayName).to.exist;",
                  "}",
                  "if (pm.response.code === 200 && pm.request.url.getQueryString().includes('token=')) {",
                  "    pm.collectionVariables.set('share_token', pm.request.url.query.find(q => q.key === 'token').value);",
                  "}"
