        },
        {
          "name": "2.6 Download File",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/download/{{uploaded_file_id}}",
              "host": [ "{{base_url}}" ],
              "path": [ "api", "download", "{{uploaded_file_id}}" ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Download response status', function () {",
                  "    pm.expect([200, 404, 410]).to.include(pm.response.code);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    pm.test('Download has attachment header', function () {",
                  "        pm.expect(pm.response.headers.get('Content-Disposition')).to.exist;",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
