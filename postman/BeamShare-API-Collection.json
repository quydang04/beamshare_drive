    {
      "name": "1. Authentication - Setup",
      "item": [
        {
          "name": "1.1 Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{login_email}}\",\n  \"password\": \"{{login_password}}\",\n  \"fullName\": \"Postman Test\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": [ "{{base_url}}" ],
              "path": [ "api", "auth", "register" ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Register status is acceptable', function () {",
                  "    pm.expect([201, 400, 409]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{login_email}}\",\n  \"password\": \"{{login_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [ "{{base_url}}" ],
              "path": [ "api", "auth", "login" ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Capture user context', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.user).to.exist;",
                  "    if (jsonData.user && jsonData.user.userId) {",
                  "        pm.collectionVariables.set('user_id', jsonData.user.userId);",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 Get Current User",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/auth/me",
              "host": [ "{{base_url}}" ],
              "path": [ "api", "auth", "me" ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Authenticated profile is available', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.user).to.exist;",
                  "    pm.expect(jsonData.user.email).to.exist;",
                  "    pm.expect(jsonData.user.userId).to.exist;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Files (Owner)",
      "item": [
        {
          "name": "2.1 List Files",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/files",
              "host": [ "{{base_url}}" ],
              "path": [ "api", "files" ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('File list request', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "    if (Array.isArray(jsonData) && jsonData.length > 0) {",
                  "        const firstId = jsonData[0].id || jsonData[0].internalName;",
                  "        if (firstId) {",
                  "            pm.collectionVariables.set('test_file_id', firstId);",
                  "            pm.collectionVariables.set('uploaded_file_id', firstId);",
                  "        }",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.2 Upload Sample File",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "{{sample_file_path}}" },
                { "key": "customName", "type": "text", "value": "{{sample_display_name}}" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/upload-single",
              "host": [ "{{base_url}}" ],
              "path": [ "api", "upload-single" ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Upload response status', function () {",
                  "    pm.expect([200, 400]).to.include(pm.response.code);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    const uploaded = jsonData && Array.isArray(jsonData.files) ? jsonData.files[0] : null;",
                  "    const newId = uploaded && (uploaded.id || uploaded.internalName);",
                  "    if (newId) {",
                  "        pm.collectionVariables.set('uploaded_file_id', newId);",
                  "        pm.collectionVariables.set('test_file_id', newId);",
                  "    }",
                  "    if (uploaded && uploaded.shareToken) {",
                  "        pm.collectionVariables.set('share_token', uploaded.shareToken);",
                  "    }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "2.3 Get File Details",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/files/{{uploaded_file_id}}/details",
              "host": [ "{{base_url}}" ],
              "path": [ "api", "files", "{{uploaded_file_id}}", "details" ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Details response status', function () {",
                  "    pm.expect([200, 404]).to.include(pm.response.code);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.displayName).to.exist;",
                  "    if (jsonData.shareToken) {",
                  "        pm.collectionVariables.set('share_token', jsonData.shareToken);",
                  "    }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "2.4 Update Share State",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"visibility\": \"public\",\n  \"regenerateToken\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/files/{{uploaded_file_id}}/share",
              "host": [ "{{base_url}}" ],
              "path": [ "api", "files", "{{uploaded_file_id}}", "share" ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Share update status', function () {",
                  "    pm.expect([200, 404, 410]).to.include(pm.response.code);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.shareToken) {",
                  "        pm.collectionVariables.set('share_token', jsonData.shareToken);",
                  "    }",
                  "    if (jsonData.shareUrl) {",
                  "        pm.collectionVariables.set('share_url', jsonData.shareUrl);",
                  "    }",
                  "}",
                  "if (pm.response.code === 404) {",
                  "    pm.collectionVariables.set('share_token', pm.collectionVariables.get('share_token') || '');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "2.5 Preview File",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/preview/{{uploaded_file_id}}",
              "host": [ "{{base_url}}" ],
              "path": [ "api", "preview", "{{uploaded_file_id}}" ]
